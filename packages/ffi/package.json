{
  "name": "p5.libprocessing.js-ffi",
  "version": "1.0.0",
  "description": "Template project for writing node package with napi-rs",
  "keywords": [
    "N-API",
    "NAPI",
    "Rust",
    "napi-rs",
    "node-addon",
    "node-addon-api"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/napi-rs/package-template.git"
  },
  "files": [
    "index.d.ts",
    "index.js",
    "browser.js"
  ],
  "main": "index.js",
  "browser": "browser.js",
  "exports": {
    ".": "./index.js"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "artifacts": "napi artifacts",
    "bench": "node benchmark/bench.ts",
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "format": "run-p format:rs format:toml",
    "format:toml": "taplo format",
    "format:rs": "cargo fmt",
    "prepublishOnly": "napi prepublish -t npm",
    "test": "ava",
    "preversion": "napi build --platform && git add .",
    "version": "napi version"
  },
  "devDependencies": {
    "@emnapi/core": "^1.5.0",
    "@emnapi/runtime": "^1.5.0",
    "@napi-rs/cli": "^3.2.0",
    "@taplo/cli": "^0.7.0",
    "@tybys/wasm-util": "^0.10.0",
    "ava": "^7.0.0",
    "chalk": "^5.6.2",
    "lint-staged": "^16.1.6",
    "npm-run-all2": "^8.0.4",
    "tinybench": "^6.0.0",
    "typescript": "^6.0.0"
  },
  "lint-staged": {
    "*.toml": [
      "taplo format"
    ]
  },
  "napi": {
    "binaryName": "p5.libprocessing.js-ffi",
    "targets": [
      "x86_64-pc-windows-msvc",
      "x86_64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-gnu",
      "armv7-unknown-linux-gnueabihf",
      "aarch64-apple-darwin",
      "x86_64-unknown-freebsd",
      "aarch64-unknown-linux-musl",
      "aarch64-pc-windows-msvc",
      "wasm32-wasip1-threads"
    ]
  },
  "ava": {
    "environmentVariables": {
      "OXC_TSCONFIG_PATH": "./__test__/tsconfig.json"
    },
    "extensions": {
      "ts": "module"
    },
    "nodeArguments": [],
    "timeout": "2m",
    "workerThreads": false
  },
  "engines": {
    "node": ">= 18.17.0 < 19 || >= 20.3.0 < 21 || >= 21.1.0"
  },
  "packageManager": "yarn@4.14.1"
}
